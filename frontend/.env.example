# URL da API (vazio = URLs relativas, Traefik roteia /api para o backend)
VITE_API_URL=

# Token de autenticação para endpoints admin (X-Service-Token)
# Mantido como fallback para dev local sem auth-service
VITE_SERVICE_TOKEN=your-service-token-here

# BKL-1115: URL do auth-service (plug-and-play IIT)
# Prod: https://auth.institutoitinerante.com.br | Dev: http://localhost:3010
VITE_AUTH_SERVICE_URL=https://auth.institutoitinerante.com.br
