# URL da API (vazio = URLs relativas, Traefik roteia /api para o backend)
VITE_API_URL=

# Token de autenticação para endpoints admin internos (X-Service-Token)
# Usado como fallback quando não há JWT (ex: CI ou seed scripts)
VITE_SERVICE_TOKEN=your-service-token-here

# URL do auth-service para autenticação JWT
VITE_AUTH_URL=https://auth.institutoitinerante.com.br
