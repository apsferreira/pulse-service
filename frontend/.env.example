# URL da API (vazio = URLs relativas, Traefik roteia /api para o backend)
VITE_API_URL=

# Token de autenticação para endpoints admin (X-Service-Token)
# Mantido como fallback para dev local sem auth-service
VITE_SERVICE_TOKEN=your-service-token-here

# URL do auth-service. Obrigatório para login via UI.
# Ex: https://auth.meudominio.com | Dev: http://localhost:3010
VITE_AUTH_SERVICE_URL=

# Modo de autenticação: "external" (auth-service via OAuth) ou "local" (email+senha direto no Pulse)
# Self-hosted sem auth-service próprio: use "local"
VITE_AUTH_MODE=external
