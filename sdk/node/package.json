{
  "name": "@pulse-iit/node",
  "version": "0.1.0",
  "description": "Pulse IIT Node.js SDK — server-side event tracking com buffering e batch flush",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
